:"Fresh synthesis; MP3 encoding only","asr":"Nice job.","asrExact":true},"9":{"src":"../audio/heart-v1/heart-dialogue-9-641efbf291cd.mp3","wordStart":0,"sentenceStart":0,"end":1.925,"text":"Thanks for your help.","sha256":"cec6558753b0b946b63c68b1841619ae459442a00a2bb5bb4c946abd9502499a","voice":"Kokoro af_heart","speed":0.82,"processing":"Fresh synthesis; MP3 encoding only","asr":"Thanks for your help.","asrExact":true},"10":{"src":"../audio/heart-v1/heart-dialogue-10-dee800686f40.mp3","wordStart":0,"sentenceStart":0,"end":1.95,"text":"I'll be right back.","sha256":"b74ef3aa9e1e025db18e418044a243e4a84fa84dc64dde649334c2b1521bc8aa","voice":"Kokoro af_heart","speed":0.82,"processing":"Fresh synthesis; MP3 encoding only","asr":"I'll be right back.","asrExact":true},"11":{"src":"../audio/heart-v1/heart-dialogue-11-9eabb3a556a9.mp3","wordStart":0,"sentenceStart":0,"end":1.825,"text":"See you later!","sha256":"03cff06cbdcb49917f65160176dd45085079f56aa65eacbf39d6ba269402eeaf","voice":"Kokoro af_heart","speed":0.82,"processing":"Fresh synthesis; MP3 encoding only","asr":"See you later.","asrExact":true},"12":{"src":"../audio/heart-v1/heart-dialogue-12-91d4ffe662b1.mp3","wordStart":0,"sentenceStart":0,"end":1.75,"text":"Good night!","sha256":"50895dbed571166bc214c81e90ff78c5be47ea015228e052a4193909bcd3cb93","voice":"Kokoro af_heart","speed":0.82,"processing":"Fresh synthesis; MP3 encoding only","asr":"Good night.","asrExact":true},"13":{"src":"../audio/heart-v1/heart-dialogue-13-cda2e290d0db.mp3","wordStart":0,"sentenceStart":0,"end":1.575,"text":"Come here!","sha256":"d36967cbb6c19e1a1d53403141af16d54b15d6954fd733f8400ccc9b1f8b5df5","voice":"Kokoro af_heart","speed":0.9,"processing":"Fresh synthesis; MP3 encoding only","asr":"Come here.","asrExact":true},"14":{"src":"../audio/heart-v1/heart-dialogue-14-602a9f74fab1.mp3","wordStart":0,"sentenceStart":0,"end":1.8,"text":"Follow me.","sha256":"fe533f58f67a434e798df2c91370afd909447ead71360207f1c4f589ff024efa","voice":"Kokoro af_heart","speed":0.82,"processing":"Fresh synthesis; MP3 encoding only","asr":"Follow me.","asrExact":true},"15":{"src":"../audio/heart-v1/heart-dialogue-15-89fe063cfe9a.mp3","wordStart":0,"sentenceStart":0,"end":1.775,"text":"Wait for me!","sha256":"7f0040da4ed2488f5b3b4956c9721c77b0711cd8c68eaeec560479426eef6f83","voice":"Kokoro af_heart","speed":0.82,"processing":"Fresh synthesis; MP3 encoding only","asr":"Wait for me.","asrExact":true},"16":{"src":"../audio/heart-v1/heart-dialogue-16-501ab0bea780.mp3","wordStart":0,"sentenceStart":0,"end":1.75,"text":"Let's go!","sha256":"1d9cd37782b2b8aa2d170e6ed7e0fabb8ae563294e9748ba02bca6112ec6fe89","voice":"Kokoro af_heart","speed":0.82,"processing":"Fresh synthesis; MP3 encoding only","asr":"Let's go.","asrExact":true},"17":{"src":"../audio/heart-v1/heart-dialogue-17-682abf18110c.mp3","wordStart":0,"sentenceStart":0,"end":1.85,"text":"Are you ready?","sha256":"a8b3fa272e004d88d4d98c5c91a33c54ae3e203d3f6ad32959949169845217a6","voice":"Kokoro af_heart","speed":0.82,"processing":"Fresh synthesis; MP3 encoding only","asr":"Are you ready?","asrExact":true},"18":{"src":"../audio/heart-v1/heart-dialogue-18-bc07637b1355.mp3","wordStart":0,"sentenceStart":0,"end":1.775,"text":"I'm ready.","sha256":"b992aa8b3c20335bc354871d01633fe725374b3c47cf77057b698c13583e8051","voice":"Kokoro af_heart","speed":0.82,"processing":"Fresh synthesis; MP3 encoding only","asr":"I'm ready.","asrExact":true},"19":{"src":"../audio/heart-v1/heart-dialogue-19-7eed8168b361.mp3","wordStart":0,"sentenceStart":0,"end":2.025,"text":"Let's stick together.","sha256":"9c10abb6bb89eda4607f88faa70d520b2f49b3b65290f576621a695c4e5d4904","voice":"Kokoro af_heart","speed":0.82,"processing":"Fresh synthesis; MP3 encoding only","asr":"Let's stick together.","asrExact":true},"20":{"src":"../audio/heart-v1/heart-dialogue-20-2b02b77fda89.mp3","wordStart":0,"sentenceStart":0,"end":1.975,"text":"Can I join you?","sha256":"3f1e3fb2bdbcd81c6cae3565b5680e5affcd1e9cbc2496a362d579d7ec508057","voice":"Kokoro af_heart","speed":0.82,"processing":"Fresh synthesis; MP3 encoding only","asr":"Can I join you?","asrExact":true},"21":{"src":"../audio/heart-v1/heart-dialogue-21-477975ca6fda.mp3","wordStart":0,"sentenceStart":0,"end":2.025,"text":"Want to play together?","sha256":"aadcba6b8c83cf34d760cc3094c8fc9afdba32e3988c787d671193408d11f024","voice":"Kokoro af_heart","speed":0.82,"processing":"Fresh synthesis; MP3 encoding only","asr":"Want to play together?","asrExact":true},"22":{"src":"../audio/heart-v1/heart-dialogue-22-2746cf12f536.mp3","wordStart":0,"sentenceStart":0,"end":2.1,"text":"Meet me at the village.","sha256":"4712b3268c37d1587bd687482c54875107bb328e1d39c7ce8ee990006265804f","voice":"Kokoro af_heart","speed":0.82,"processing":"Fresh synthesis; MP3 encoding only","asr":"Meet me at the village.","asrExact":true},"23":{"src":"../audio/heart-v1/heart-dialogue-23-2f53209a0888.mp3","wordStart":0,"sentenceStart":0,"end":2.175,"text":"I'll meet you at the base.","sha256":"2db52d7efb21a65389f50abf038cacf25e2dfb4ce583b2387dce053ea4aae5e9","voice":"Kokoro af_heart","speed":0.82,"processing":"Fresh synthesis; MP3 encoding only","asr":"I'll meet you at the base.","asrExact":true},"24":{"src":"../audio/heart-v1/heart-dialogue-24-8062c5688fbd.mp3","wordStart":0,"sentenceStart":0,"end":2.175,"text":"Come to the spawn point.","sha256":"52591d2ac56774fa14551c64f4be3942c0ecf67010034acd937a6ac60849c54f","voice":"Kokoro af_heart","speed":0.82,"processing":"Fresh synthesis; MP3 encoding only","asr":"Come to the spawn point.","asrExact":true},"25":{"src":"../audio/heart-v1/heart-dialogue-25-b0323ea62419.mp3","wordStart":0,"sentenceStart":0,"end":2.075,"text":"Who's coming with us?","sha256":"a3dae26efee6e3662aafc6bbbbd9675f56aabc32b3af0a64014d1cad3175dd32","voice":"Kokoro af_heart","speed":0.82,"processing":"Fresh synthesis; MP3 encoding only","asr":"Who's coming with us?","asrExact":true},"26":{"src":"../audio/heart-v1/heart-dialogue-26-0c20b962cd35.mp3","wo